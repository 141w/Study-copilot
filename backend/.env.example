# ==================================
# Study Copilot - Environment Config
# ==================================
# Copy this file to .env and fill in your values.
# ⚠️  CHANGE ALL DEFAULTS BEFORE DEPLOYING TO PRODUCTION ⚠️

# --- OpenAI 配置 ---
# API key for the LLM provider (required in production)
OPENAI_API_KEY=sk-please-replace-with-your-real-api-key
# Base URL for the OpenAI-compatible API endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name to use for completions
OPENAI_MODEL=gpt-3.5-turbo

# --- Embedding 配置 ---
# Sentence-transformer model for embeddings (Chinese-optimized default)
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# Embedding vector dimension (must match the model output)
EMBEDDING_DIMENSION=768

# --- JWT 配置 ---
# Secret key for signing JWT tokens (REQUIRED: generate a strong random string in production!)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=please-replace-with-a-strong-random-secret-key-at-least-32-chars
# JWT signing algorithm
JWT_ALGORITHM=HS256
# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 数据库 ---
# SQLAlchemy async database URL
DATABASE_URL=postgresql+asyncpg://study_user:please-replace-with-a-strong-password@localhost:5432/study_copilot

# --- 文件上传 ---
# Directory for uploaded files
UPLOAD_DIR=./uploads
# Maximum file size in bytes (default 50MB)
MAX_FILE_SIZE=52428800

# --- FAISS 向量库 ---
# Directory for FAISS vector stores
VECTORSTORE_DIR=./vectorstore
# Number of top results to retrieve in RAG
TOP_K=5

# --- 应用配置 ---
APP_NAME=Study Copilot
APP_VERSION=1.0.0
# Enable debug mode (SQL echo, etc.) — set to false in production
DEBUG=true
# Allowed CORS origins (comma-separated). MUST override when deploying to a domain:
# CORS_ORIGINS=https://your-domain.com

# --- Encryption ---
# Key for encrypting API keys at rest (Fernet symmetric encryption)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI 互动课堂配置 ---
CLASSROOM_ENABLED=true
CLASSROOM_BASE_URL=http://localhost:3001
CLASSROOM_WEBHOOK_SECRET=
