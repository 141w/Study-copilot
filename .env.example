# ============================================
# Study Copilot - Docker Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# ⚠️  CHANGE ALL DEFAULTS BEFORE DEPLOYING TO PRODUCTION ⚠️

# --- Database (REQUIRED) ---
# PostgreSQL password (required, no default)
POSTGRES_PASSWORD=please-replace-with-strong-password

# --- Encryption (REQUIRED) ---
# Fernet key for encrypting API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- JWT (REQUIRED) ---
# Secret key for signing JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=please-replace-with-a-strong-random-secret-key

# --- 构建镜像源（可选，仅影响 docker compose build）---
# 国内服务器上 deb.debian.org 拉包可能慢到几十分钟，可指向国内/云内网镜像站。
# 阿里云 VPC 内机器可用：http://mirrors.cloud.aliyuncs.com/debian
# 留空 = 使用官方源（海外环境默认行为）。
APT_MIRROR=

# Python 依赖镜像源（可选，仅影响 docker compose build）
# torch 本体始终走 PyTorch 官方 CPU 索引，此项只作为其余依赖的补充索引。
# 阿里云 ECS 用公网镜像：https://mirrors.aliyun.com/pypi/simple/
# （注意：VPC 内网 mirrors.cloud.aliyuncs.com 的 HTTPS 证书域名不匹配，
#   pip 会报 "Certificate did not match expected hostname"；要用内网只能走 http 并加 trusted-host）
PIP_INDEX_URL=

# PyTorch CPU 轮子索引（可选，仅影响构建）。国内可指向镜像站，例如：
# https://mirror.sjtu.edu.cn/pytorch-wheels/cpu
TORCH_INDEX_URL=

# 应用对外映射的宿主地址与端口。同机已有 nginx 占用 80/443 时改为 8080，
# 再由宿主 nginx 反代；默认仅本机 80。
APP_BIND=127.0.0.1
APP_HOST_PORT=80

# 前端部署子路径（构建参数）。与别的站点共用域名和证书时设为 /study/，
# 由宿主 nginx 把 /study/ 前缀剥掉转发给本应用。默认 / 表示挂在域名根路径。
VITE_BASE=/

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# --- Embedding ---
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_DIMENSION=768


# --- 安全 / 运行模式（生产务必核对）---
# 生产必须 false。勿把 docker-compose.dev.yml 用于生产；裸 `docker compose` 不会自动开 DEBUG。
DEBUG=false
# 开放自助注册。默认 true（注册即用）。生产若要关闭改为 false。
# 用户模型走 BYOK（登录后在「模型设置」自填 Key），注册不再消耗服务器 LLM 额度。
ALLOW_REGISTRATION=true

# Cloudflare Turnstile 人机验证（免费）。都留空 = 跳过验证（本地/内网）。
# 配置 SECRET 后注册强制核销；SITE_KEY 用于前端组件。申请：dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# CORS：同域 SPA 通常无需配置；跨域调用时覆盖（逗号分隔）
# CORS_ORIGINS=https://wweiqi.devs.surf
# --- Optional ---
# HuggingFace mirror (use hf-mirror.com in China)
HF_ENDPOINT=https://hf-mirror.com
# Frontend API URL (auto-detected in production)
VITE_API_URL=/api
